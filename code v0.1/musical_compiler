import matplotlib.pyplot as plt

# interpret instructions in text
def parse_instruction(line):
    parts = line.strip().split()
    return {
        "nota": parts[1],
        "duracion": float(parts[3]),
        "inicio": float(parts[5])
    }

# Data structure for visualization
def compile_music(script_text):
    instrucciones = script_text.strip().split('\n')
    return [parse_instruction(line) for line in instrucciones]

#matplotlib visualization
def note_to_y(nota):
    # note convertion to a vertical number to graph (ex: C4) 
    notas = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B']
    nombre_nota = nota[:-1]
    octava = int(nota[-1])

# Manejo de notas con sostenido o bemol (ej. C#)
    if len(nombre_nota) > 1 and (nombre_nota.endswith('#') or nombre_nota.endswith('b')):
        nombre_base = nombre_nota[:-1]
        alteracion = nombre_nota[-1]
        if alteracion == '#':
            # Asumimos que la nota base está en la lista
            pos_base = notas.index(nombre_base)
            pos_final = (pos_base + 1)
        # Se podría añadir lógica para bemoles si fuera necesario
    else:
        pos_final = notas.index(nombre_nota)
        
    return octava * 12 + pos_final


def visualize(piano_roll):
    fig, ax = plt.subplots(figsize=(12, 8))
    
    y_ticks = sorted(list(set([note_to_y(note["nota"]) for note in piano_roll])))
    y_labels = []

    # Crear un diccionario para mapear las posiciones a los nombres de las notas
    pos_to_note_name = {note_to_y(note["nota"]): note["nota"] for note in piano_roll}
    y_labels = [pos_to_note_name[y] for y in y_ticks]

    for note in piano_roll:
        y = note_to_y(note["nota"])
        ax.broken_barh([(note["inicio"], note["duracion"])], (y - 0.4, 0.8), facecolors='cornflowerblue')
        ax.text(note["inicio"] + note["duracion"]/2, y, note["nota"], ha='center', va='center', color='white', weight='bold')
    
    fig, ax = plt.subplots()
    for note in piano_roll:
        y = note_to_y(note["nota"])
        ax.broken_barh([(note["inicio"], note["duracion"])], (y - 0.4, 0.8), facecolors='tab:blue')
        ax.text(note["inicio"] + note["duracion"]/2, y, note["nota"], ha='center', va='center', color='white')

    ax.set_xlabel("Tiempo (s)")
    ax.set_ylabel("Notas")
    ax.set_yticks(y_ticks)
    ax.set_yticklabels(y_labels)
    ax.grid(True)
    plt.title("Visualización de Piano Roll")
    plt.show()

# Script musical 
script = """
play E4 for 1.0 at 0.0
play E4 for 1.0 at 1.0
play F4 for 1.0 at 2.0
play G4 for 1.0 at 3.0
play G4 for 1.0 at 4.0
play F4 for 1.0 at 5.0
play E4 for 1.0 at 6.0
play D4 for 1.0 at 7.0
play C4 for 1.0 at 8.0
play C4 for 1.0 at 9.0
play D4 for 1.0 at 10.0
play E4 for 1.0 at 11.0
play E4 for 1.0 at 12.0
